// BFS
class Solution {
public:
    vector<pair<int, int>> directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
    vector<vector<int>> floodFill(vector<vector<int>>& image, int sr, int sc, int color) {
        
        int startColor = image[sr][sc];

        if(startColor == color){
            return image;
        }

        int rows = image.size();
        int cols = image[0].size();

        queue<pair<int, int>> q;
        q.push({sr, sc});

        image[sr][sc] = color;

        while(!q.empty()){

            pair<int, int> curr = q.front();
            q.pop();
            int x = curr.first;
            int y = curr.second;

            for(auto& dir : directions){
                int x_ = x + dir.first;
                int y_ = y + dir.second;

                if(x_ >= 0 && x_ < rows && y_ >= 0 && y_ < cols && image[x_][y_] == startColor){
                    image[x_][y_] = color;
                    q.push({x_, y_});
                }
            }
        }
        return image;
    }
};

// DFS
class Solution {
public:
    vector<pair<int, int>> directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};

    vector<vector<int>> dfs(vector<vector<int>>& image, int& startColor, int sr, int sc, int& color){
        image[sr][sc] = color;

        for(auto& dir : directions){
            int x = sr + dir.first;
            int y = sc + dir.second;

            if(x >= 0 && x < image.size() && y >= 0 && y < image[0].size() && image[x][y] == startColor){
                dfs(image, startColor, x, y, color);
            }
        }
        return image;
    }
    vector<vector<int>> floodFill(vector<vector<int>>& image, int sr, int sc, int color) {
        int startColor = image[sr][sc];
        if(startColor == color) return image;

        dfs(image, startColor, sr, sc, color);

        return image;

    }
};
